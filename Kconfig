# ─────────────────────────────────────────────────────────────────────────────
# Lua peripheral driver compile-time toggles.
# These symbols gate individual driver modules within the Lua VM. All default y; disable to shed code size.
#   Consumed by: lua/CMakeLists.txt (_kconfig_disable macro).
# ─────────────────────────────────────────────────────────────────────────────

menu "Lua Peripheral Drivers"

config CLAW_LUA_DRV_GPIO
	bool
	# Hidden: lua_module_event.c has a hard link-time dependency on
	# lua_gpio_dispatch/lua_gpio_get_ev_sema. Until event.wait() is decoupled
	# from the GPIO driver (e.g. via registered callbacks), this symbol cannot
	# be user-configurable without breaking the SW module layer.
	default y

config CLAW_LUA_DRV_I2C
	bool "Lua I2C bus driver"
	default y

config CLAW_LUA_DRV_SPI
	bool "Lua SPI bus driver"
	default y

config CLAW_LUA_DRV_UART
	bool "Lua UART driver"
	default y

config CLAW_LUA_DRV_PWM
	bool "Lua PWM driver"
	default y

config CLAW_LUA_DRV_ADC
	bool "Lua ADC driver"
	default y

config CLAW_LUA_DRV_RTC
	bool "Lua RTC driver"
	default y

config CLAW_LUA_DRV_IR
	bool "Lua IR driver"
	default y

config CLAW_LUA_DRV_AUDIO
	bool "Lua Audio (DMIC/I2S) driver"
	default n

config CLAW_LUA_DRV_THERMAL
	bool "Lua on-chip thermal sensor driver"
	default y

config CLAW_LUA_DRV_CAPTOUCH
	bool "Lua on-chip capacitive touch driver"
	default y

config CLAW_LUA_DRV_BASICTIMER
	bool "Lua basic timer driver"
	default y

config CLAW_LUA_DRV_LED_STRIP
	bool "Lua addressable LED strip driver"
	default y

config CLAW_LUA_DRV_IMU
	bool "Lua IMU module (MPU-6050 and similar, over I2C)"
	depends on CLAW_LUA_DRV_I2C
	default y

config CLAW_LUA_DRV_ENV_SENSOR
	bool "Lua environmental sensor module (over I2C)"
	depends on CLAW_LUA_DRV_I2C
	default y

config CLAW_LUA_DRV_LIGHT_SENSOR
	bool "Lua light sensor module (over I2C)"
	depends on CLAW_LUA_DRV_I2C
	default y

config CLAW_LUA_DRV_MAGNETOMETER
	bool "Lua magnetometer module (BMM150, over I2C)"
	depends on CLAW_LUA_DRV_I2C
	default y

config CLAW_LUA_DRV_USB_UVC
	bool "Lua USB UVC camera driver"
	select USB_OTG_EN_MENU
	select USBH_UVC_MENU
	default n

config CLAW_LUA_DRV_USB_MSC
	bool "Lua USB MSC storage driver"
	select USB_OTG_EN_MENU
	select USBH_MSC_MENU
	default n

config CLAW_LUA_DRV_LVGL
	bool "Lua LVGL binding"
	select GRAPHIC_UI_MENU
	select LVGL_ENABLE
	default y

endmenu

endmenu
