# ameba_claw/Kconfig — application-owned build options.
#
# HOW THIS IS PICKED UP (no SDK edit needed):
#   menuconfig sets RTK_APP_DIR to the directory holding the external prj.conf
#   (this directory), and the SoC project Kconfig ends with
#       orsource "${RTK_APP_DIR}/Kconfig"
#   so every symbol below is merged into the config tree automatically.
#
# SCOPE — define ONLY ameba_claw's own toggles here (no SDK symbols):
#   SDK symbols owned by a single ameba_claw feature use `select` here to
#   create the coupling (e.g. CLAW_LUA_DRV_LVGL selects LVGL_ENABLE;
#   CLAW_LUA_DRV_USB_* selects USB_OTG_EN_MENU + class driver).
#   Platform-baseline SDK symbols with no ameba_claw owner (flash layout,
#   USB host-mode preference, stack sizes …) stay in prj.conf — they are
#   hardware-level decisions that belong to the integrator, not to a feature.
#
# Each symbol below is wired to a real build gate — see the "Consumed by:" line.
# Do not add a symbol here unless something actually reads it, or it becomes a
# dead knob that toggles nothing.

menu "Ameba Claw"

config CLAW_LUA_DRIVER_TESTS
	bool "Build Lua peripheral driver test scripts"
	default n
	help
	  Embed the per-driver *.lua test scripts into the rolfs image and expose
	  the AT+CLAW=<peripheral>,<test> dispatch. Off by default to keep the
	  image lean; enable it for a development build that needs the per-driver
	  test scripts.
	  Consumed by: lua/CMakeLists.txt, claw_modules/claw_atcmd/CMakeLists.txt,
	  top-level CMakeLists.txt (LUA_DRIVER_TESTS_ENABLED).

config CLAW_BUILD_TESTS
	bool "Build C unit tests (claw_test.c + AT+CLAW=test)"
	default n
	help
	  Compile test/claw_test.c and the cap/mem/router/fs unit-test AT dispatch
	  (AT+CLAW=test,...). Off by default; excluded from release builds.
	  Consumed by: top-level CMakeLists.txt,
	  claw_modules/claw_atcmd/CMakeLists.txt.

config CLAW_AGENT_AUTO_TEST
	bool "Build agent auto-test harness (peripheral stimulus)"
	default n
	help
	  Compile the agent auto-test path: startup GPIO pull-up init in
	  app_example.c and the AT+CLAW=gpio_ctrl stimulus dispatch. Used by the
	  dual-board GPIO stimulus bench. Off by default → zero image cost in
	  release builds.
	  Consumed by: top-level CMakeLists.txt,
	  claw_modules/claw_atcmd/CMakeLists.txt.

# ─────────────────────────────────────────────────────────────────────────────
# Capability compile-time trimming (goal #1 of design_spec/arch/
# kconfig_cap_trimming_plan.md).
#
# Each CONFIG_CLAW_CAP_* below gates BOTH the CMake ameba_add_subdirectory()
# for that capability (whether it is compiled/linked at all) AND — for the very
# few caps referenced by name from a core module — the C #ifdef around that
# reference. All default y, so a full build is unchanged; trimming is explicit
# opt-out. A cap's own .c files carry ZERO #if — a disabled cap simply is not
# compiled, so its self-registration constructor never exists and it drops out
# of the runtime registry.
#
# `depends on` expresses genuine cap→cap link dependencies so an illegal combo
# (e.g. IM_WECHAT without IM_ATTACHMENT) cannot be selected. cap_lua is CORE
# (always compiled, no symbol) — cap_files / cap_skill_mgr / the serial REPL
# depend on it.
#   Consumed by: CMakeLists.txt (subdir gating),
#                claw_modules/claw_atcmd/src/atcmd_im.c (IM_WECHAT #ifdef),
#                ameba_claw_main.c (IM_LOCAL #ifdef).
# ─────────────────────────────────────────────────────────────────────────────

menu "Capabilities (compile-time)"

