{
  "$chip": "RTL8721F",
  "$extends": "EV721FL0_R03",
  "board": {
    "name": "EV721FL0_R03_BreadBoard",
    "chip": "RTL8721FLM",
    "description": "EV721FL0_R03 开发板 + 面包板扩展（SH1106 OLED 1.3\" + 按键 A/B/C）"
  },
  "interfaces": [
    {
      "id": "i2c0",
      "type": "i2c",
      "instance": "I2C0",
      "sda": "PA_26",
      "scl": "PA_25",
      "default_freq_khz": 400
    }
  ],
  "devices": [
    {
      "id": "ptt",
      "name": "Button D",
      "type": "button",
      "params": {
        "pin": "PA_15",
        "active_low": true
      },
      "lua_module": "gpio",
      "notes": "低电平有效，建议开启内部上拉（GPIO_PuPd_UP）"
    },
    {
      "id": "oled",
      "name": "SH1106 OLED 1.3\"",
      "type": "display",
      "chip": "SH1106",
      "interface": "i2c0",
      "params": {
        "address": "0x3C",
        "resolution": "128x64",
        "col_offset": 2,
        "pages": 8
      },
      "lua_module": "i2c",
      "notes": "SH1106 内部 132 列，可见区从硬件列 col_offset=2 开始；set_cursor 需三条命令：0xB0|page, 0x10|(col>>4), col&0x0F；"
    },
    {
      "id": "btn_a",
      "name": "Button A",
      "type": "button",
      "params": {
        "pin": "PA_22",
        "active_low": true
      },
      "lua_module": "gpio",
      "notes": "低电平有效，建议开启内部上拉（GPIO_PuPd_UP）"
    },
    {
      "id": "btn_b",
      "name": "Button B",
      "type": "button",
      "params": {
        "pin": "PA_23",
        "active_low": true
      },
      "lua_module": "gpio",
      "notes": "低电平有效，建议开启内部上拉（GPIO_PuPd_UP）"
    },
    {
      "id": "btn_c",
      "name": "Button C",
      "type": "button",
      "params": {
        "pin": "PA_24",
        "active_low": true
      },
      "lua_module": "gpio",
      "notes": "低电平有效，建议开启内部上拉（GPIO_PuPd_UP）"
    }
  ]
}
